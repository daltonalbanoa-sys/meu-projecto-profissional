<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Inglês Pro - Premium EdTech</title>
 
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;900&display=swap" rel="stylesheet">

  <style>
    /* RESET & VARIÁVEIS DE DESIGN SYSTEM */
    :root {
      --bg-main: #0f172a;      
      --bg-card: #1e293b;      
      --color-primary: #3b82f6;  
      --color-success: #10b981;  
      --color-error: #ef4444;    
      --color-warn: #f59e0b;    
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --font-rounded: 'Nunito', sans-serif;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      font-family: var(--font-rounded);
      background-color: var(--bg-main);
      color: var(--text-main);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      padding: 16px;
      overflow-x: hidden;
    }

    .app-container {
      width: 100%;
      max-width: 480px;
      display: flex;
      flex-direction: column;
      gap: 20px;
      margin-top: 10px;
    }

    h1.brand-title {
      font-size: 1.5rem;
      font-weight: 900;
      letter-spacing: 1px;
      text-transform: uppercase;
      color: var(--color-primary);
      text-align: center;
      margin-top: 10px;
    }

    /* HEADER & STATUS BAR */
    .status-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: var(--bg-card);
      padding: 12px 18px;
      border-radius: 20px;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
      border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .status-item {
      display: flex;
      align-items: center;
      gap: 6px;
      font-weight: 700;
      font-size: 1rem;
    }

    .badge-level {
      background: rgba(59, 130, 246, 0.15);
      color: #60a5fa;
      padding: 4px 12px;
      border-radius: 50px;
      border: 1px solid rgba(59, 130, 246, 0.3);
      font-size: 0.85rem;
      font-weight: 800;
    }

    .badge-moedas { color: var(--color-warn); }
    .badge-vidas { color: var(--color-error); letter-spacing: 2px; }

    /* TRILHA / PROGRESS BAR */
    .learning-track {
      background: rgba(255, 255, 255, 0.05);
      height: 10px;
      border-radius: 10px;
      display: flex;
      overflow: hidden;
      gap: 3px;
      padding: 2px;
    }
    .track-step {
      flex: 1;
      height: 100%;
      background: #334155;
      transition: all 0.4s ease;
      border-radius: 2px;
    }
    .track-step.complete { background: var(--color-success); }
    .track-step.current { background: var(--color-primary); box-shadow: 0 0 8px var(--color-primary); }

    /* CARD PRINCIPAL DO JOGO */
    .game-box {
      background: var(--bg-card);
      border-radius: 28px;
      padding: 28px 24px;
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3), 0 10px 10px -5px rgba(0, 0, 0, 0.2);
      border: 1px solid rgba(255, 255, 255, 0.08);
      text-align: center;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .palavra-container {
      background: rgba(15, 23, 42, 0.4);
      padding: 20px;
      border-radius: 20px;
      border: 1px dashed rgba(255, 255, 255, 0.1);
      position: relative;
    }

    #wordDisplay {
      font-size: 1.6rem;
      font-weight: 800;
      color: var(--text-main);
      margin-bottom: 12px;
      line-height: 1.4;
      white-space: pre-wrap;
    }

    button {
      font-family: var(--font-rounded);
      font-weight: 700;
      font-size: 1rem;
      padding: 14px 20px;
      border: none;
      border-radius: 16px;
      cursor: pointer;
      transition: background-color 0.2s, transform 0.1s, box-shadow 0.1s;
      width: 100%;
      outline: none;
    }

    .btn-audio {
      width: auto;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: #334155;
      color: #e2e8f0;
      padding: 8px 16px;
      font-size: 0.9rem;
      border-bottom: 3px solid #1e293b;
    }
    .btn-audio:active { transform: translateY(3px); border-bottom-width: 0px; margin-bottom: 3px; }

    #optionsContainer {
      display: flex;
      flex-direction: column;
      gap: 12px;
      width: 100%;
    }

    #optionsContainer button {
      background: #334155;
      color: var(--text-main);
      border-bottom: 4px solid #1e293b;
      text-align: left;
      padding-left: 20px;
    }
    #optionsContainer button:hover { background: #475569; }
    #optionsContainer button:active { transform: translateY(4px); border-bottom-width: 0px; margin-bottom: 4px; }

    input[type="text"] {
      font-family: var(--font-rounded);
      width: 100%;
      padding: 14px;
      border-radius: 16px;
      border: 2px solid #334155;
      background: #0f172a;
      color: white;
      font-size: 1.1rem;
      text-align: center;
      font-weight: 600;
      outline: none;
      transition: border-color 0.2s;
    }
    input[type="text"]:focus { border-color: var(--color-primary); }

    .btn-verificar { background: var(--color-primary); color: white; border-bottom: 4px solid #1d4ed8; margin-top: 10px; }
    .btn-verificar:active { transform: translateY(4px); border-bottom-width: 0px; margin-bottom: 4px; }

    .feedback {
      font-size: 1.1rem;
      font-weight: 800;
      min-height: 1.6em;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 12px;
    }

    .footer-actions {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      border-top: 1px solid rgba(255,255,255,0.05);
      padding-top: 15px;
    }

    .btn-utility {
      background: transparent;
      border: 2px dashed #475569;
      color: var(--text-muted);
      font-size: 0.85rem;
      padding: 10px;
    }
    .btn-utility:hover { border-color: var(--color-warn); color: var(--color-warn); }

    .btn-menu-niveis {
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.1);
      color: var(--text-main);
      padding: 10px;
      font-size: 0.85rem;
    }

    .btn-reset {
      background: none;
      border: none;
      color: #64748b;
      text-decoration: underline;
      font-size: 0.8rem;
      cursor: pointer;
      font-weight: 600;
    }
    .btn-reset:hover { color: var(--color-error); }

    /* MODAIS */
    .modal-overlay {
      display: none;
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(15, 23, 42, 0.75);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      z-index: 2000;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .modal {
      background: var(--bg-card);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 24px;
      padding: 24px;
      width: 100%;
      max-width: 400px;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
      text-align: center;
      animation: scaleUp 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    @keyframes scaleUp { from { transform: scale(0.9); opacity: 0; } to { transform: scale(1); opacity: 1; } }

    .modal h2 { font-weight: 900; margin-bottom: 15px; }

    .resumo-lista {
      text-align: left;
      max-height: 180px;
      overflow-y: auto;
      margin: 15px 0;
      padding: 12px;
      background: #0f172a;
      border-radius: 16px;
      font-size: 0.9rem;
      line-height: 1.6;
      border: 1px solid rgba(255,255,255,0.05);
    }

    .btn-proximo { background: var(--color-success); color: white; border-bottom: 4px solid #047857; }
    .btn-proximo:active { transform: translateY(4px); border-bottom-width: 0px; margin-bottom: 4px; }

    .btn-tentar-novamente { background: var(--color-error); color: white; border-bottom: 4px solid #b91c1c; }
    .btn-tentar-novamente:active { transform: translateY(4px); border-bottom-width: 0px; margin-bottom: 4px; }

    .grid-niveis {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
      margin: 20px 0;
    }

    .nivel-item {
      aspect-ratio: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 16px;
      background: #334155;
      font-weight: 800;
      font-size: 1.1rem;
      border-bottom: 4px solid #1e293b;
      color: var(--text-muted);
    }
    .nivel-completo { background: var(--color-success); border-color: #047857; color: white; }
    .nivel-atual { background: var(--color-primary); border-color: #1d4ed8; color: white; box-shadow: 0 0 12px rgba(59,130,246,0.5); }

    .shake { animation: shake 0.4s ease-in-out; }
    @keyframes shake { 0%, 100% {transform: translateX(0);} 20%, 60% {transform: translateX(-6px);} 40%, 80% {transform: translateX(6px);} }
  </style>
</head>
<body>

  <div class="app-container">
    <h1 class="brand-title">Inglês Pro</h1>

    <div class="status-bar">
      <div class="status-item badge-level" id="levelBadge">NÍVEL 1</div>
      <div class="status-item badge-moedas" id="moedasDisplay">🪙 5</div>
      <div class="status-item badge-vidas" id="vidasDisplay">❤️❤️❤️</div>
    </div>

    <div class="learning-track" id="mapaNiveis"></div>
   
    <div class="game-box" id="gameBox">
      <div class="palavra-container">
        <h2 id="wordDisplay">...</h2>
        <button class="btn-audio" onclick="falarPalavra()">🔊 Ouvir Pronúncia</button>
      </div>

      <div id="optionsContainer"></div>
      <div class="feedback" id="feedbackDisplay"></div>
     
      <div class="footer-actions">
          <button class="btn-utility" onclick="revelarResposta()">💡 Dica (3 🪙)</button>
          <button class="btn-menu-niveis" onclick="abrirMenuNiveis()">📊 Trilha</button>
      </div>

      <div style="text-align: center; margin-top: 5px;">
        <span id="scoreDisplay" style="font-weight: 800; color: var(--text-muted); font-size: 0.9rem;">Pontos: 0</span>
      </div>
    </div>

    <div style="text-align: center; margin-top: 10px;">
        <button onclick="resetarJogo()" class="btn-reset">Reiniciar Jornada</button>
    </div>
  </div>

  <div id="modalFimNivel" class="modal-overlay">
    <div class="modal">
      <h2 id="tituloModal">Nível Concluído! 🏆</h2>
      <div class="resumo-lista" id="resumoConteudo"></div>
      <p id="textoProgresso" style="font-weight: 700; margin-bottom: 20px; color: var(--text-muted);"></p>
      <div id="modalAcaoContainer"></div>
    </div>
  </div>

  <div id="modalMapa" class="modal-overlay">
    <div class="modal">
      <h2>Mapa de Níveis</h2>
      <div class="grid-niveis" id="gridNiveis"></div>
      <button class="btn-verificar" onclick="fecharModais()">Voltar ao Jogo</button>
    </div>
  </div>

  <script>
    const n1 = [{pt:"casa", en:"house"}, {pt:"gato", en:"cat"}, {pt:"livro", en:"book"}, {pt:"maçã", en:"apple"}, {pt:"carro", en:"car"}];
    const n2 = [{pt:"janela", en:"window"}, {pt:"cachorro", en:"dog"}, {pt:"estrada", en:"road"}, {pt:"caneta", en:"pen"}];
    const n3 = [{pt:"conhecimento", en:"knowledge"}, {pt:"pensamento", en:"thought"}, {pt:"esperança", en:"hope"}];
    const n4 = [...n1, ...n2];
    const n5 = [{dialogo: "A: Hi! How are you?\nB: _____", correta: "I'm fine, thank you."}, {dialogo: "A: What is your name?\nB: _____", correta: "My name is Anna."}];
    const n6 = [{pergunta: "A: What time is it?\nB: _____", resposta: "It is three o'clock"}, {pergunta: "A: How old are you?\nB: _____", resposta: "I am 25 years old"}];
    const n7 = [{pt:"trabalho", en:"work"}, {pt:"escola", en:"school"}, {pt:"cidade", en:"city"}];
    const n8 = [{pt:"felicidade", en:"happiness"}, {pt:"coragem", en:"courage"}, {pt:"paz", en:"peace"}];
    const n9 = [{pergunta: "A: Can you help me?\nB: _____", resposta: "Yes, of course."}, {pergunta: "A: I love pizza.", resposta: "Me too"}];
    const n10 = [{dialogo: "A: Have you been to Paris?\nB: _____", correta: "Yes, once."}];

    const niveisDB = { 1: n1, 2: n2, 3: n3, 4: n4, 5: n5, 6: n6, 7: n7, 8: n8, 9: n9, 10: n10 };

    let moedas = parseInt(localStorage.getItem("moedas")) || 5;
    let nivel = parseInt(localStorage.getItem("nivel")) || 1;
    let pontuacao = parseInt(localStorage.getItem("pontuacao")) || 0;
    let vidas = 3;
    let palavrasRestantes = [];
    let palavraAtual;
    let historicoNivel = [];
    let errosNoNivelAtual = 0; // Nova variável de controle de performance

    const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    function tocarSom(tipo) {
      try {
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.connect(gain); gain.connect(audioCtx.destination);
        if(tipo === 'acerto') { osc.frequency.value = 587.33; gain.gain.value = 0.08; }
        else { osc.frequency.value = 146.83; gain.gain.value = 0.12; }
        osc.start(); osc.stop(audioCtx.currentTime + 0.15);
      } catch(e) {}
    }

    function falarPalavra() {
      const txt = document.getElementById("wordDisplay").textContent.replace(/A:|B:|_____/g, "");
      const msg = new SpeechSynthesisUtterance(txt);
      msg.lang = 'en-US';
      window.speechSynthesis.speak(msg);
    }

    function atualizarInterface() {
      document.getElementById("moedasDisplay").textContent = `🪙 ${moedas}`;
      document.getElementById("scoreDisplay").textContent = `Pontos: ${pontuacao}`;
      document.getElementById("levelBadge").textContent = `NÍVEL ${nivel}`;
      document.getElementById("vidasDisplay").textContent = "❤️".repeat(vidas) + "🤍".repeat(3-vidas);
     
      const mapa = document.getElementById("mapaNiveis");
      mapa.innerHTML = Array.from({length: 10}, (_, i) => {
        let classe = 'track-step';
        if (i+1 < nivel) classe += ' complete';
        else if (i+1 === nivel) classe += ' current';
        return `<div class="${classe}"></div>`;
      }).join("");
     
      localStorage.setItem("moedas", moedas);
      localStorage.setItem("nivel", nivel);
      localStorage.setItem("pontuacao", pontuacao);
    }

    function novaPalavra() {
      const lista = niveisDB[nivel] || n1;
     
      if (palavrasRestantes.length === 0) {
        palavrasRestantes = [...lista];
        historicoNivel = [];
        errosNoNivelAtual = 0; // Reinicia o contador de erros ao iniciar um nível
      }

      palavraAtual = palavrasRestantes.splice(Math.floor(Math.random() * palavrasRestantes.length), 1)[0];
     
      document.getElementById("feedbackDisplay").textContent = "";
      document.getElementById("feedbackDisplay").style.color = "inherit";
      const container = document.getElementById("optionsContainer");
      container.innerHTML = "";

      if (nivel === 5 || nivel === 10) {
        document.getElementById("wordDisplay").textContent = palavraAtual.dialogo;
        palavraAtual.esperada = palavraAtual.correta;
        gerarOpcoesDialogo();
      } else if (nivel === 6 || nivel === 9) {
        document.getElementById("wordDisplay").textContent = palavraAtual.pergunta;
        palavraAtual.esperada = palavraAtual.resposta;
        container.innerHTML = `
          <input type="text" id="respostaInput" placeholder="Escreva a resposta em inglês..." autocomplete="off">
          <button class="btn-verificar" onclick="verificarResposta(document.getElementById('respostaInput').value)">Verificar Resposta</button>
        `;
        document.getElementById('respostaInput').addEventListener('keypress', function(e) {
          if (e.key === 'Enter') verificarResposta(this.value);
        });
      } else {
        document.getElementById("wordDisplay").textContent = palavraAtual.pt;
        palavraAtual.esperada = palavraAtual.en;
        gerarOpcoesMultiplas(lista);
      }
      atualizarInterface();
    }

    function gerarOpcoesMultiplas(lista) {
      let ops = new Set([palavraAtual.esperada]);
      let tentativas = 0;
      while(ops.size < 4 && tentativas < 30) {
        let r = lista[Math.floor(Math.random()*lista.length)];
        if(r && r.en) ops.add(r.en);
        tentativas++;
      }
      if(ops.size < 4) {
        n1.forEach(item => { if(ops.size < 4) ops.add(item.en); });
      }
      Array.from(ops).sort(()=>Math.random()-0.5).forEach(t => {
        const b = document.createElement("button"); b.textContent = t;
        b.onclick = () => verificarResposta(t); document.getElementById("optionsContainer").appendChild(b);
      });
    }

    function gerarOpcoesDialogo() {
      [palavraAtual.correta, "I don't know.", "Maybe.", "See you."].sort(()=>Math.random()-0.5).forEach(t => {
        const b = document.createElement("button"); b.textContent = t;
        b.onclick = () => verificarResposta(t); document.getElementById("optionsContainer").appendChild(b);
      });
    }

    function verificarResposta(resp) {
      if(!resp) return;
      const isCorreta = resp.toLowerCase().trim() === palavraAtual.esperada.toLowerCase().trim();
      const txtRelatorio = document.getElementById("wordDisplay").textContent.split('\n')[0].substring(0,15);

      if (isCorreta) {
        tocarSom('acerto'); moedas++; pontuacao += 10;
        document.getElementById("feedbackDisplay").textContent = "✨ Excelente! Correto";
        document.getElementById("feedbackDisplay").style.color = "var(--color-success)";
        historicoNivel.push({ q: txtRelatorio, r: palavraAtual.esperada, s: "✅" });
      } else {
        tocarSom('erro'); vidas--; errosNoNivelAtual++; // Computa o erro na rodada
        document.getElementById("feedbackDisplay").textContent = "❌ Resposta incorreta";
        document.getElementById("feedbackDisplay").style.color = "var(--color-error)";
        document.getElementById("gameBox").classList.add("shake");
        historicoNivel.push({ q: txtRelatorio, r: palavraAtual.esperada, s: "❌" });
        setTimeout(() => document.getElementById("gameBox").classList.remove("shake"), 400);
      }

      setTimeout(() => {
        if (vidas <= 0) {
          alert("Vidas esgotadas! Reiniciando nível.");
          reiniciarNivelAtual();
        }
        else if (palavrasRestantes.length === 0) {
          avaliarResultadoNivel();
        }
        else {
          novaPalavra();
        }
      }, 1200);
    }

    // Validação da nova condição: Só passa se os erros forem iguais a 0
    function avaliarResultadoNivel() {
      const titulo = document.getElementById("tituloModal");
      const texto = document.getElementById("textoProgresso");
      const containerBotao = document.getElementById("modalAcaoContainer");
      const res = document.getElementById("resumoConteudo");
     
      res.innerHTML = "";
      historicoNivel.forEach(i => res.innerHTML += `<div>${i.s} <span>${i.q}...</span> -> <b>${i.r}</b></div>`);
      containerBotao.innerHTML = "";

      if (errosNoNivelAtual === 0) {
        // GANHOU PERFEITO!
        tocarSom('acerto');
        moedas += 5; // Bônus extra por passar sem erros
        titulo.textContent = "Aproveitamento Perfeito! 🏆";
        titulo.style.color = "var(--color-success)";
        texto.textContent = `Incrível! Você ganhou +5 moedas de bônus por não cometer erros!`;
        containerBotao.innerHTML = `<button class="btn-proximo" onclick="irParaProximoNivel()">Avançar Nível ➔</button>`;
      } else {
        // FALHOU NA CONDIÇÃO DE 100%
        titulo.textContent = "Nível Não Concluído 📑";
        titulo.style.color = "var(--color-error)";
        texto.textContent = `Para avançar, você precisa acertar TODAS as questões da rodada sem errar nenhuma. Tente novamente!`;
        containerBotao.innerHTML = `<button class="btn-tentar-novamente" onclick="reiniciarNivelAtual()">Tentar Novamente ↻</button>`;
      }
     
      document.getElementById("modalFimNivel").style.display = "flex";
      atualizarInterface();
    }

    function reiniciarNivelAtual() {
      fecharModais();
      vidas = 3;
      palavrasRestantes = [];
      novaPalavra();
    }

    function irParaProximoNivel() {
      fecharModais();
      nivel++;
     
      if (nivel > 10) {
        alert("🏆 PARABÉNS! VOCÊ COMPLETOU TODOS OS NÍVEIS COM PERFEIÇÃO!");
        resetarJogo();
      } else {
        vidas = 3;
        palavrasRestantes = [];
        localStorage.setItem("nivel", nivel);
        novaPalavra();
      }
    }

    function abrirMenuNiveis() {
      const g = document.getElementById("gridNiveis"); g.innerHTML = "";
      for (let i = 1; i <= 10; i++) {
        let c = "nivel-item";
        let displayContent = i;
        if (i < nivel) { c += " nivel-completo"; displayContent = "✓"; }
        else if (i === nivel) { c += " nivel-atual"; }
        g.innerHTML += `<div class="${c}">${displayContent}</div>`;
      }
      document.getElementById("modalMapa").style.display = "flex";
    }

    function fecharModais() { document.querySelectorAll('.modal-overlay').forEach(m => m.style.display = 'none'); }
   
    // Gastar moedas para salvar a rodada e economizar
    function revelarResposta() {
      if(moedas >= 3){
        moedas -= 3;
        alert("Dica Premium: A resposta correta é '" + palavraAtual.esperada + "'");
        atualizarInterface();
      } else {
        alert("Moedas insuficientes! Você precisa de 3 moedas.");
      }
    }
   
    function resetarJogo() { localStorage.clear(); location.reload(); }

    window.onload = function() {
      palavrasRestantes = [];
      novaPalavra();
    };
  </script>
</body>
</html>
